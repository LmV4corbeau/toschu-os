{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "helpers:pinGitHubActionDigests"],
  "rebaseWhen": "never",
  "pinDigests": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^config/tools\\.yml$/"],
      "matchStrings": [
        "(?m)^[ \\t]*- name: (?<depName>[^\\s]+)[ \\t]*\\n[ \\t]+version: \"(?<currentValue>[^\"]+)\"[ \\t]*\\n[ \\t]+repo: (?<registryUrl>[^\\s]+)"
      ],
      "datasourceTemplate": "rpm",
      "versioningTemplate": "rpm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^config/apps\\.yml$/"],
      "matchStrings": [
        "(?m)^[ \\t]*- name: (?<depName>[^\\s]+)[ \\t]*\\n[ \\t]+repo: (?<packageName>[^\\s]+)[ \\t]*\\n[ \\t]+version: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^config/distrobox\\.yml$/"],
      "matchStrings": [
        "(?m)^[ \\t]+base: (?<depName>[^\\s@]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})[ \\t]*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchFileNames": ["config/distrobox.yml", "distrobox/**/Containerfile"],
      "groupName": "Distrobox base images"
    }
  ]
}
